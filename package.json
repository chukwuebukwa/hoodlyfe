{
  "name": "nock0",
  "version": "0.2.0",
  "private": true,
  "description": "Browser-based top-down multiplayer city sandbox.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets:export": "bash scripts/export-gta2-assets.sh",
    "assets:export-buildings": "GTA2_CROP_SIZE=256 GTA2_GEOMETRY_ONLY=1 bash scripts/export-gta2-assets.sh",
    "buildings:import": "tsx scripts/building-draft-pipeline.ts",
    "buildings:publish": "BUILDING_RUN_EXPORT=1 tsx scripts/building-draft-pipeline.ts",
    "district:export": "tsx scripts/export-local-district.ts",
    "assets:original-map": "python3 scripts/render-original-district.py",
    "map:expand": "tsx scripts/expand-district-map.ts",
    "map:generate-roads": "tsx scripts/generate-full-road-network.ts",
    "map:generate-downtown": "npm run district:export -- wil 256",
    "map:generate-residential": "npm run district:export -- ste 256",
    "map:compile-world": "tsx scripts/compile-world-atlas.ts",
    "world:configure-bucket": "tsx scripts/configure-world-content-bucket.ts",
    "world:publish": "tsx scripts/publish-world-content.ts",
    "map:generate-raceway": "node scripts/generate-raceway-district.mjs",
    "map:generate-deathmatch": "node scripts/generate-raceway-district.mjs --deathmatch",
    "map:validate": "tsx scripts/validate-district-map.ts",
    "vehicles:build": "tsx scripts/compile-vehicles.ts",
    "vehicles:check": "tsx scripts/compile-vehicles.ts --check",
    "level:apply": "tsx scripts/apply-level-editor-bundle.ts",
    "physics:soak": "tsx scripts/bench/persistent-physics-soak.ts",
    "physics:loadtest": "tsx scripts/loadtest/district-physics.ts --endpoint ws://127.0.0.1:2567 --room district --numClients 32 --delay 100",
    "bots:map": "LOADTEST_MAP_TRAVERSAL=1 LOADTEST_DURATION_MS=180000 LOADTEST_RECONNECT_INTERVAL_MS=600000 tsx scripts/loadtest/district-physics.ts --endpoint ws://127.0.0.1:2567 --room district --numClients 10 --delay 200 --logLevel none",
    "build": "tsc --noEmit && next build",
    "deploy:railway": "railway up --service \"hoodlyfe game\" --environment production",
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:client": "npm run dev:web",
    "dev:server": "tsx watch --env-file-if-exists=.env.local server/index.ts",
    "dev:web": "next dev -H 0.0.0.0 -p 5173",
    "start": "npm run dev",
    "test:netcode": "tsx --test test/combat-fire-command-controller.test.ts test/combat-fire-command-sender.test.ts test/combat-fire-protocol.test.ts test/combat-hitbox-history.test.ts test/projectile-lag-compensation.test.ts test/debug-shell-contract.test.ts test/netcode-rollout-config.test.ts test/netcode-rollout-controller.test.ts test/netcode-rollout-protocol.test.ts test/network-quality-controller.test.ts test/on-foot-step.test.ts test/remote-motion-timeline.test.ts test/remote-timeline-impairment.test.ts test/remote-timeline-policy.test.ts test/vehicle-humanoid-server-contact.test.ts test/vehicle-server-contact-phase.test.ts test/vehicle-step.test.ts",
    "start:prod": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@colyseus/core": "0.16.24",
    "@colyseus/schema": "3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "@dimforge/rapier2d-compat": "0.19.3",
    "colyseus.js": "0.16.22",
    "cors": "2.8.5",
    "express": "4.21.2",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "tsx": "4.23.0"
  },
  "devDependencies": {
    "@colyseus/loadtest": "0.16.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "concurrently": "9.2.1",
    "playwright-core": "^1.61.1",
    "sharp": "^0.34.5",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
