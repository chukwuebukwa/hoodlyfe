NEXT_PUBLIC_GAME_SERVER_URL=

# Versioned M11 netcode rollout. All stages default on when omitted.
GAME_NETCODE_ROLLOUT_REVISION=m11-all-on
GAME_NETCODE_REMOTE_TIMELINES=1
GAME_NETCODE_INTERACTION_SNAPSHOTS=1
GAME_NETCODE_INTERACTION_REPLAY=1
GAME_NETCODE_COMBAT_REWIND=1
GAME_NETCODE_PROJECTILE_PREDICTION=1
