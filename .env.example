NEXT_PUBLIC_GAME_SERVER_URL=

# Production level-editor gate. Development access remains open on localhost.
EDITOR_PRODUCTION_ENABLED=0
EDITOR_AUTH_USER=
EDITOR_AUTH_PASSWORD=

# Optional Railway Bucket (S3-compatible) for future cloud drafts, published
# level revisions, and private district packages. Railway can auto-inject these.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_S3_URL_STYLE=virtual

# Optional proximity voice transport. Keep the API secret server-side.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Versioned M11 netcode rollout. All stages default on when omitted.
GAME_NETCODE_ROLLOUT_REVISION=m11-all-on
GAME_NETCODE_REMOTE_TIMELINES=1
GAME_NETCODE_INTERACTION_SNAPSHOTS=1
GAME_NETCODE_INTERACTION_REPLAY=1
GAME_NETCODE_COMBAT_REWIND=1
GAME_NETCODE_PROJECTILE_PREDICTION=1
